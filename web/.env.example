# Netlify / Vite — Atrium SPA
# Copy to web/.env.local for local runs.

# Supabase (Auth + Edge tenants/knowledge):
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# LangGraph worker (Cloud Run or local uvicorn). Empty → Edge stub / fixtures.
# VITE_WORKER_URL=http://127.0.0.1:8000
# VITE_WORKER_URL=https://atrium-worker-xxxxx.run.app

# Force fixture mock (CI default when Supabase unset):
# VITE_ATRIUM_RUNTIME=fixtures
