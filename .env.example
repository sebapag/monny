# Monny runtime — copy to .env and fill secret refs as needed.
# Values are resolved from env by name referenced in tenant.yaml (secret_ref).
# Never put real tokens into tenant YAML or git.

MONNY_DRY_RUN=1
MONNY_LIVE=0
MONNY_TENANTS_DIR=tenants
MONNY_DATA_DIR=data
MONNY_DEFAULT_TENANT=demo
MONNY_API_HOST=127.0.0.1
MONNY_API_PORT=8000
MONNY_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Frontend (Vite / Netlify) — set when the SPA is not same-origin with the API:
# VITE_API_BASE_URL=https://YOUR-CLOUD-RUN-URL
# (legacy alias: VITE_API_BASE)

# --- Tenant secret_ref names (demo) — leave empty for fixture/dry-run ---
SHOPIFY_TOKEN_DEMO=
GOOGLE_ADS_DEMO=
META_ADS_DEMO=
GSC_DEMO=

# --- Tenant secret_ref names (acme) — optional second portable tenant ---
SHOPIFY_TOKEN_ACME=
GOOGLE_ADS_ACME=
META_ADS_ACME=
GSC_ACME=

# --- Global live extras (required only when MONNY_LIVE=1) ---
# Google Ads API also needs a developer token (not stored in tenant.yaml):
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional MCC / manager account:
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# To enable live reads (still no unattended writes without HITL approve):
#   MONNY_LIVE=1
#   MONNY_DRY_RUN=0
#   <secret_ref from tenant.yaml>=<token>

# --- Optional planner LLM (xAI Grok) ---
# Leave XAI_API_KEY empty for local/CI: keyword stub planner (no network).
# When set, the LangGraph planner asks Grok for a short skill plan (JSON only).
XAI_API_KEY=
# Light non-reasoning chat model for short planning (override if needed):
MONNY_LLM_MODEL=grok-4.20-0309-non-reasoning
# OpenAI-compatible base URL (xAI default):
MONNY_LLM_BASE_URL=https://api.x.ai/v1
