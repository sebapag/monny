# Monny runtime — copy to .env and fill secret refs as needed.
# Values are resolved from env by name referenced in tenant.yaml (secret_ref).
# Never put real tokens into tenant YAML or git.

MONNY_DRY_RUN=1
MONNY_LIVE=0
MONNY_TENANTS_DIR=tenants
MONNY_DATA_DIR=data
MONNY_DEFAULT_TENANT=demo
MONNY_API_HOST=127.0.0.1
MONNY_API_PORT=8000
MONNY_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Secret refs used by tenants/demo/tenant.yaml (leave empty for dry-run)
SHOPIFY_TOKEN_DEMO=
GOOGLE_ADS_DEMO=
META_ADS_DEMO=
GSC_DEMO=
